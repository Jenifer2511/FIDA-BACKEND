# PostgreSQL connection string from your managed database provider.
# Keep server-only; do not prefix this variable with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: use only for a local PostgreSQL server without TLS.
# DATABASE_SSL=disable

# Admin sign-in credentials. Use a unique, strong password.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate a separate random value of at least 32 characters.
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Uploaded images are stored directly in PostgreSQL. No image-host credentials needed.
# Optional: stable production backend origin used in image URLs (no trailing path).
PUBLIC_API_BASE_URL=https://your-storefront-domain.example

# Exact origin(s) of the independently deployed admin frontend
ADMIN_ORIGIN=https://your-admin-site.example
